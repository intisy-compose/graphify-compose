# Copy to .env and fill in. .env is gitignored. docker compose reads this file.

# API key the graphify MCP server requires. Generate any strong random string and
# use the same value in your MCP client configuration. Required.
GRAPHIFY_API_KEY=

# Absolute path to the folder holding the projects you want graphed and browsed.
# Mounted read-only into the containers at /projects. Change it to wherever your
# repositories live. Required.
PROJECTS_ROOT=
