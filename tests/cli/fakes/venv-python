#!/usr/bin/env bash
# Stands in for the venv's python, copied into a scratch stack's venv. It appends
# "venv-python ARGUMENTS | cwd=... | limit=..." to $FAKE_DOCKER_DIR/calls and answers:
#   -m graphify update PATH  writes graphify-out/graph.json under its working folder, unless the state
#                            names update-exit (exit with it) or no-graph (write nothing)
#   -m graphify watch PATH   writes its pid to watch-pid (and watch-pids) and runs until it is killed,
#                            keeping its command line, as the real one does, so it can be found by it
set -uo pipefail
state=${FAKE_DOCKER_DIR:?}
printf 'venv-python %s | cwd=%s | limit=%s\n' "$*" "$PWD" "${GRAPHIFY_VIZ_NODE_LIMIT:-}" >>"$state/calls"
[ "${1:-}" = -m ] && [ "${2:-}" = graphify ] || exit 2
case "${3:-}" in
    update)
        [ ! -f "$state/update-exit" ] || exit "$(cat "$state/update-exit")"
        [ -f "$state/no-graph" ] || { mkdir -p graphify-out && : >graphify-out/graph.json; } ;;
    watch)
        printf '%s\n' "$$" >>"$state/watch-pids"
        printf '%s' "$$" >"$state/watch-pid"
        while :; do "${REAL_SLEEP:?}" 1; done ;;
    *) exit 2 ;;
esac
